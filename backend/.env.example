# ============================================================
# ShopSense AI — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control — it is in .gitignore.
# In production (Render), set these as environment variables
# in the Render dashboard, NOT in this file.
# ============================================================

# Supabase project URL (from Supabase dashboard → Project Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase server-side key — use the service_role key (never the anon key for backend)
# Found in: Supabase dashboard → Project Settings → API → service_role
SUPABASE_KEY=your_supabase_service_role_key

# Google Gemini API key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key

# Comma-separated list of allowed CORS origins.
# Local: http://localhost:3000
# Production: https://your-vercel-app.vercel.app
# Both: http://localhost:3000,https://your-vercel-app.vercel.app
CORS_ORIGINS=http://localhost:3000

# ----------------------------------------------------------
# Optional — Render sets PORT automatically; do not hardcode
# ----------------------------------------------------------
# PORT=5000
