# ============================================================
# ShopSense AI — Frontend Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ----------------------------------------------------------
# PUBLIC — exposed to the browser (NEXT_PUBLIC_ prefix)
# ----------------------------------------------------------

# The base API URL used by the browser-side API client.
# Local development: point to Flask directly (Next.js proxy handles /api/* rewrites)
# Production (Vercel): set to /api — the proxy routes to BACKEND_URL server-side
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ----------------------------------------------------------
# SERVER-SIDE ONLY — never sent to the browser
# ----------------------------------------------------------

# The internal Flask backend URL used by Next.js server-side rendering (SSR).
# Next.js API proxy rewrites /api/* → BACKEND_URL/api/* at the server level.
# Local: http://localhost:5000
# Production (Vercel): https://your-render-app.onrender.com
BACKEND_URL=http://localhost:5000

# ----------------------------------------------------------
# NEVER put these in the frontend:
#   GEMINI_API_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#   SUPABASE_KEY
# Those belong in backend/.env only.
# ----------------------------------------------------------
